generator client {
  provider      = "prisma-client-js"
  // Prisma only bundles the query engine binary for whatever platform
  // `prisma generate` actually ran on — this repo has only ever been built
  // on this Mac, so every packaged Windows release so far shipped with
  // zero working database engine (query_engine binary present for
  // darwin-arm64 only), meaning literally every DB-backed page crashed on
  // launch and fell straight to the generic Next.js error boundary.
  // "native" keeps local dev working on whatever machine runs `generate`;
  // "windows" adds the x64 engine electron-builder's Windows targets need
  // (works under emulation for the arm64 NSIS build too — Prisma has no
  // separate windows-arm64 engine to target).
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js) ----------

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String?
  name                  String?
  phone                 String?
  /// A real contact email for filling into 网申 forms — `email` above is the
  /// local single-user account's internal identifier (defaults to a
  /// placeholder like "me@local") and must never be used for that.
  contactEmail          String?
  /// Free text rather than an enum, matching this app's convention
  /// elsewhere (see Contact.role) — a fixed list doesn't fit everyone.
  gender                String?
  /// Stored as plain text (YYYY-MM-DD from a date input), not DateTime —
  /// this is purely informational for 网申 autofill, never used in date
  /// arithmetic elsewhere, so there's no reason to deal with timezones.
  birthDate             String?
  school                String?
  targetTrack           String?
  graduationYear        Int?
  skills                String?
  preferredCities       String?
  expectedSalaryMin     Int?
  emailVerified         DateTime?
  image                 String?
  // Bring-your-own AI key(s) — see AiKey below, one row per provider, AES
  // -encrypted at rest (src/lib/crypto.ts). defaultAiProvider picks which
  // configured key the general text-only AI features use; file-reading
  // features (JD parsing, resume check, resume match) ignore this and
  // always look up the "gemini" key specifically, since only Gemini's API
  // here can read a PDF/image directly.
  defaultAiProvider     String?
  // Local build only: sends reminder digests via the user's own mailbox
  // (SMTP) since there's no always-on server here to run a hosted email
  // service against. Password is AES-encrypted the same way as the AI key.
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPasswordEncrypted String?
  smtpFrom              String?
  // This build has no cloud sync — a user running the app on two machines
  // (e.g. Windows + Mac) has two entirely independent local databases, kept
  // in step only by manually exporting/importing a backup. Tracked so the
  // settings page can nudge "it's been N days" instead of the user finding
  // out their data diverged only after it already has.
  lastBackupAt          DateTime?
  createdAt             DateTime  @default(now())

  accounts                Account[]
  sessions                Session[]
  positions               Position[]
  applications            Application[]
  resumeVersions          ResumeVersion[]
  autofillAnswers         AutofillAnswer[]
  addedCompanies          Company[]
  attachments             Attachment[]
  interviewPreps          InterviewPrep[]
  groupInterviewPreps     GroupInterviewPrep[]
  coverLetters            CoverLetter[]
  interviewNoteExtracts   InterviewNoteExtract[]
  stagePostmortems        StagePostmortem[]
  interviewQAs            InterviewQA[]
  personalTasks           PersonalTask[]
  interviewSessions       InterviewSession[]
  personalityTestResults  PersonalityTestResult[]
  careerFitAnalysis       CareerFitAnalysis?
  aiKeys                  AiKey[]
  jobLeads                JobLead[]
  questionBanks           QuestionBank[]
  examSessions            ExamSession[]
  mailAccounts            MailAccount[]
  contacts                Contact[]
  positionMatches         PositionMatch[]
  resumeTailorings        ResumeTailoring[]
  skillGapAnalyses        SkillGapAnalysis[]
  resumeDrills            ResumeDrill[]
  dailyDigests            DailyDigest[]
  weeklyReviews           WeeklyReview[]
  resumeComparisonSummary ResumeComparisonSummary?
  interviewIntelligence   InterviewIntelligence?
}

/// One AI-curated "today's top priorities" per day, cached so opening the
/// dashboard repeatedly doesn't repeatedly pay for an AI call — regenerating
/// the same day overwrites via the (userId, date) unique constraint.
model DailyDigest {
  id        String   @id @default(cuid())
  userId    String
  /// YYYY-MM-DD in the user's local timezone, not UTC.
  date      String
  /// [{label, reason, href}]
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// Weekly retrospective, one row per (user, week) — same "cache the paid AI
/// call, overwrite on regenerate" shape as DailyDigest, just on a weekly
/// instead of daily cadence and covering the whole week's activity rather
/// than picking today's priorities.
model WeeklyReview {
  id        String   @id @default(cuid())
  userId    String
  /// Monday of the reviewed week, YYYY-MM-DD local time — see weekStartKey()
  /// in src/lib/dates.ts.
  weekStart String
  /// WeeklyReviewResult from src/lib/actions/weekly-review.ts: narrative
  /// (summary/highlights/concerns/suggestions) plus the deterministically
  /// computed stats block it was written from.
  summary   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

/// One per user, regenerated on demand — not periodic like WeeklyReview,
/// just "the last comparison I asked for" since it's a global summary over
/// every ResumeVersion's applications, not scoped to one entity.
model ResumeComparisonSummary {
  id        String   @id @default(cuid())
  userId    String   @unique
  narrative String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Aggregates InterviewNoteExtract (面经库 questions) + StagePostmortem
/// (per-interview reflections) across the user's whole history into one
/// "how am I doing across interview categories" view, plus a suggested
/// category mix for the next mock interview — one per user, regenerated on
/// demand, same "global summary, not periodic" shape as
/// ResumeComparisonSummary above.
model InterviewIntelligence {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// { summary, categories: [{category, performance, note}], nextSessionMix: [{category, percent}] }
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One inbox to scan for job-related mail — a user routinely needs several:
/// recruiters require whatever mailbox provider they standardize on (e.g.
/// Tencent → QQ mailbox, NetEase → 163 mailbox), so a single-mailbox scan
/// config misses everything sent to the others. Deliberately independent of
/// User's smtp* fields, which are the *sending* identity for reminder
/// digests — that's a separate concern from which inboxes get read.
model MailAccount {
  id                String    @id @default(cuid())
  userId            String
  /// User-given name so multiple accounts are distinguishable at a glance
  /// ("QQ邮箱" / "网易邮箱") — falls back to the email address if blank.
  label             String?
  imapHost          String
  imapPort          Int
  email             String
  passwordEncrypted String
  enabled           Boolean   @default(true)
  /// Per-account, not global — accounts added at different times must not
  /// all inherit one shared "since" cursor, or a newly-added account would
  /// either re-scan years of mail (cursor null) or skip its own backlog
  /// (cursor copied from an older account).
  lastCheckedAt     DateTime?
  /// IMAP UID high-water mark — the actual de-dup cursor. lastCheckedAt
  /// alone isn't enough: IMAP's SEARCH SINCE only has day granularity (no
  /// time-of-day), so two scans on the same calendar day both re-match
  /// every message since midnight and re-create a 待办 for mail already
  /// processed earlier that day. UIDs are stable and strictly increasing
  /// within one mailbox, so "uid > lastSeenUid" never re-matches a message
  /// already seen, regardless of how many times per day this runs.
  lastSeenUid       Int?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiKey {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  apiKeyEncrypted String
  model           String?
  // Only meaningful for OpenAI-compatible providers (openai/deepseek/kimi/qwen)
  // — overrides that provider's default base URL, for workspace-specific or
  // self-hosted OpenAI-compatible endpoints (e.g. Alibaba Cloud 百炼's
  // per-workspace MaaS gateway, which isn't the same for every account).
  baseUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain ----------

model Company {
  id            String   @id @default(cuid())
  name          String   @unique
  industry      String?
  size          String?
  logoUrl       String?
  careerUrl     String?
  sector        String?
  verified      Boolean  @default(false)
  addedByUserId String?
  createdAt     DateTime @default(now())

  /// 岗位雷达：定时抓取招聘页内容，用 hash 做免费的前置过滤；hash 变化时才
  /// 触发一次 AI 结构化提取 + 岗位快照 diff（见 RadarJobPosting/RadarJobEvent），
  /// 算出具体 NEW/UPDATED/REMOVED 的岗位，而不是只说"内容变了"。
  radarEnabled       Boolean   @default(false)
  radarContentHash   String?
  radarLastCheckedAt DateTime?
  radarLastChangedAt DateTime?
  radarLastError     String?
  radarLastWarning   String?
  /// 手动登记的公开岗位 JSON 接口（如果找到的话）——优先于 careerUrl 的
  /// 静态 HTML/渲染抓取。不同招聘系统的接口形态千差万别，没有通用方式能
  /// 自动探测，所以这是一个需要用户/维护者手动找到并填入的覆盖项，不是
  /// 自动发现的。
  structuredApiUrl   String?

  addedBy          User?             @relation(fields: [addedByUserId], references: [id])
  positions        Position[]
  applications     Application[]
  aliases          CompanyAlias[]
  radarJobPostings RadarJobPosting[]
  radarJobEvents   RadarJobEvent[]
}

/// Current snapshot of postings believed still active on a company's
/// careerUrl — one row per (company, title) the last successful radar
/// extraction saw. removedAt is set (not deleted) when a later check no
/// longer finds this title, so "岗位历史" (when did this posting first
/// appear / last change / disappear) stays queryable.
model RadarJobPosting {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  /// A short AI-written one-line summary (direction/location/key
  /// requirement) — not the full JD. Used only to detect "this posting's
  /// content changed" between checks; exact-title matching means a renamed
  /// posting will show as REMOVED+NEW rather than UPDATED, a known and
  /// documented limitation rather than a silently wrong diff.
  summary     String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  removedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, title])
  @@index([companyId])
}

/// Append-only log of what RadarJobPosting diffs actually found — this is
/// what gets surfaced in the UI (NEW postings offer a manual "导入到秋招
/// 信息库" action; nothing here auto-creates a JobLead on its own, matching
/// this app's "no silent background mutations" convention).
model RadarJobEvent {
  id        String            @id @default(cuid())
  companyId String
  title     String
  type      RadarJobEventType
  /// For UPDATED: the posting's new summary. Null for NEW/REMOVED.
  detail    String?
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

enum RadarJobEventType {
  NEW
  UPDATED
  REMOVED
}

/// Recorded when src/lib/company-resolver.ts's AI-assisted check decides a
/// newly-seen name (e.g. "DJI") refers to an existing Company (e.g. "大疆创
/// 新") — zero string overlap between such pairs means plain substring/fuzzy
/// matching can't catch them, only real-world knowledge can. Once recorded,
/// re-seeing that exact string resolves instantly without another AI call.
model CompanyAlias {
  id        String   @id @default(cuid())
  companyId String
  alias     String   @unique
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum PositionStatus {
  EVALUATING
  PLANNED
  APPLIED
  DROPPED
}

/// A raw row from an imported 秋招信息表 — the wide, messy, mostly-irrelevant
/// list that circulates in group chats. Deliberately NOT a Position: the
/// candidate pool is the small curated set the user actually intends to apply
/// to, and dumping hundreds of leads into it would bury that. Leads live here
/// until the user promotes one, at which point promotedPositionId is set so
/// the library can show it's already been taken.
model JobLead {
  id                 String    @id @default(cuid())
  userId             String
  companyName        String
  title              String
  track              String?
  department         String?
  location           String?
  salaryMin          Int?
  salaryMax          Int?
  deadline           DateTime?
  source             String?
  jdUrl              String?
  note               String?
  /// 0-100 from the AI resume match; null until the user runs a match.
  fitScore           Int?
  fitReason          String?
  /// Filename of the sheet this came from, so a bad import can be found again.
  batch              String?
  promotedPositionId String?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Position {
  id             String         @id @default(cuid())
  userId         String
  companyId      String
  title          String
  track          String?
  department     String?
  location       String?
  salaryMin      Int?
  salaryMax      Int?
  jdText         String?
  jdUrl          String?
  source         String?
  scoreBreakdown Json?
  interestScore  Int?
  deadline       DateTime?
  status         PositionStatus @default(EVALUATING)
  createdAt      DateTime       @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            Company             @relation(fields: [companyId], references: [id])
  applications       Application[]
  interviewPrep      InterviewPrep?
  groupInterviewPrep GroupInterviewPrep?
  coverLetter        CoverLetter?
  personalTasks      PersonalTask[]
  interviewSessions  InterviewSession[]
  contacts           Contact[]
  positionMatches    PositionMatch[]
  resumeTailorings   ResumeTailoring[]
  resumeDrills       ResumeDrill[]

  @@index([userId])
}

enum ApplicationStage {
  APPLIED
  SCREENING
  ASSESSMENT
  OA
  INTERVIEW_1
  INTERVIEW_2
  INTERVIEW_3
  HR_INTERVIEW
  OFFER
  REJECTED
  ACCEPTED
  DECLINED
}

model Application {
  id               String           @id @default(cuid())
  userId           String
  positionId       String?
  companyId        String
  resumeVersionId  String?
  title            String
  appliedDate      DateTime
  referrer         String?
  source           String?
  currentStage     ApplicationStage @default(APPLIED)
  currentStageDate DateTime         @default(now())
  salaryMin        Int?
  salaryMax        Int?
  offerNote        String?
  /// Offer comparison beyond the headline monthly salary. A 30K/month offer
  /// with a 90-minute commute and routine 996 is not the same offer as a 28K
  /// one twenty minutes away, and comparing on salaryMin/Max alone hides
  /// exactly that.
  /// Total annual package in 万元 (base + bonus + stock), as offers here are
  /// quoted that way; monthly salary stays in salaryMin/Max as K.
  offerAnnualTotal Int?
  /// One-way commute in minutes.
  commuteMinutes   Int?
  /// Free text rather than an enum — "大小周", "弹性但晚上要盯线上" and
  /// "旺季前一个月封闭" are all real answers that no fixed list covers.
  overtimeNote     String?
  /// Growth prospects: team, mentor, tech stack, promotion path.
  growthNote       String?
  createdAt        DateTime         @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  position      Position?      @relation(fields: [positionId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id])
  stageHistory  StageHistory[]
  attachments   Attachment[]
  interviewQA   InterviewQA?
  personalTasks PersonalTask[]
  contacts      Contact[]

  @@index([userId])
}

model StageHistory {
  id              String           @id @default(cuid())
  applicationId   String
  stage           ApplicationStage
  enteredAt       DateTime         @default(now())
  note            String?
  interviewFormat String?
  interviewer     String?
  nextDeadline    DateTime?
  /// End of a window when the next step isn't a single fixed moment — 笔试/
  /// 测评 links routinely say "8月26日-8月30日期间任意时间可测" rather than
  /// giving one deadline. Null means nextDeadline is a single point in time
  /// (an interview slot, a fixed deadline); set means [nextDeadline,
  /// nextDeadlineEnd] is the window.
  nextDeadlineEnd DateTime?

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  noteExtract InterviewNoteExtract?
  postmortem  StagePostmortem?

  @@index([applicationId])
}

/// AI-structured version of one StageHistory.note — 面经库 notes are
/// free-text a user typed after an interview ("问了我讲讲 Redis 持久化，
/// 还问了一道场景题..."), never structured. Extracted on demand (a button
/// per note, not automatic — same "don't spend the user's AI budget without
/// an explicit click" convention as InterviewPrep/CoverLetter), one per
/// StageHistory, regenerating overwrites.
model InterviewNoteExtract {
  id             String   @id @default(cuid())
  userId         String
  stageHistoryId String   @unique
  /// [{question, category}]
  questions      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageHistory StageHistory @relation(fields: [stageHistoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A per-interview reflection, distinct from WeeklyReview which aggregates
/// across a whole week — this captures "what went wrong in THIS interview"
/// right after it happens, while detail is still fresh, before it fades into
/// a vague weekly summary.
model StagePostmortem {
  id             String   @id @default(cuid())
  userId         String
  stageHistoryId String   @unique
  /// { reflectionQuestions: string[], improvements: string[] }
  content        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageHistory StageHistory @relation(fields: [stageHistoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Attachment {
  id             String   @id @default(cuid())
  userId         String
  applicationId  String?
  stageHistoryId String?
  url            String
  name           String
  /// Shelf in the 资料库 (证书 / 作品集 / 笔试资料 / 其他). Null on the
  /// attachments that predate the library, and on ones uploaded straight
  /// onto an application, where the application itself is the context.
  category       String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageHistory StageHistory? @relation(fields: [stageHistoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([stageHistoryId])
}

model ResumeVersion {
  id            String    @id @default(cuid())
  userId        String
  name          String
  fileUrl       String?
  targetTrack   String?
  isDefault     Boolean   @default(false)
  // Cached AI review — each run is a paid call, so results persist instead of
  // re-running every time the page is opened.
  checkScore    Int?
  checkResult   Json?
  checkedAt     DateTime?
  // Plain-text extraction of the resume's actual content (education/
  // experience/projects/skills) — read once so features that need real
  // resume content (网申自动填充) stop re-reading and re-sending the whole
  // file to an AI on every single use. Populated in the background right
  // after upload; null until that finishes or if it was never triggered
  // (older resumes from before this field existed) — callers fall back to
  // reading the raw file in that case, so this is a pure optimization.
  extractedText String?
  extractedAt   DateTime?
  createdAt     DateTime  @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications      Application[]
  interviewSessions InterviewSession[]
  resumeDrill       ResumeDrill?
  autofillAnswers   AutofillAnswer[]
  positionMatches   PositionMatch[]
  resumeTailorings  ResumeTailoring[]
  skillGapAnalysis  SkillGapAnalysis?

  @@index([userId])
}

/// Cached 岗位匹配 result for one (position, resume version) pair — each run
/// is a paid AI call, and the score also feeds the daily digest without that
/// needing its own AI call just to know "is this a good match".
model PositionMatch {
  id              String   @id @default(cuid())
  userId          String
  positionId      String
  resumeVersionId String
  matchScore      Int
  /// 强烈建议投 / 可以投 / 海投备用 / 不建议浪费时间
  recommendation  String
  /// { breakdown: [{requirement, evidence, verdict}], suggestion }
  result          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position      Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@unique([positionId, resumeVersionId])
  @@index([userId])
}

model ResumeTailoring {
  id              String   @id @default(cuid())
  userId          String
  positionId      String
  resumeVersionId String
  /// { summary, rewrites: [{original, suggested, reason}] }
  result          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position      Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@unique([positionId, resumeVersionId])
  @@index([userId])
}

/// 简历深挖模拟: an interviewer's follow-up tree over the candidate's own
/// resume, one per resume version (regenerating overwrites the tree AND
/// wipes answers — the question ids don't survive regeneration, so stale
/// answers would point at nothing). Different from InterviewSession, which
/// is a free-flowing chat: here the questions are fixed up front, grouped
/// per project/experience and layered L1→L3, so the user can drill one
/// project at a time and see exactly which probes they haven't survived yet.
model ResumeDrill {
  id              String   @id @default(cuid())
  userId          String
  resumeVersionId String   @unique
  positionId      String?
  /// { projects: [{ id, name, summary, questions: [{ id, level, question, intent, keyPoints }] }] }
  tree            Json
  /// { [questionId]: { answer, score, feedback, betterAnswer, followUp, answeredAt } }
  answers         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  position      Position?     @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Aggregated across every tracked Position's jdText — not tied to one
/// position the way ResumeTailoring/PositionMatch are, so it keys on just
/// (userId, resumeVersionId). Regenerating overwrites, same as everywhere
/// else in this file — it's a snapshot of "what the JDs I'm watching say"
/// at generation time, not a live-updating view.
model SkillGapAnalysis {
  id              String   @id @default(cuid())
  userId          String
  resumeVersionId String   @unique
  /// { summary, skills: [{skill, mentionCount, onResume, note}] }
  result          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A 网申表单开放性问题 the AI answered once, kept so a similar question on a
/// different site's form reuses it instead of re-generating (and re-paying
/// for) an answer every time. Matched by text similarity against
/// questionLabel at lookup time — see answer-questions/route.ts.
model AutofillAnswer {
  id              String   @id @default(cuid())
  userId          String
  resumeVersionId String
  questionLabel   String
  answer          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([userId, resumeVersionId])
}

// Pre-application prep guide: what to prepare before applying. Lives on
// Position because that's the "haven't applied yet" stage — Application only
// exists once 标记已投. One per position; regenerating overwrites.
model InterviewPrep {
  id         String   @id @default(cuid())
  userId     String
  positionId String   @unique
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Same "one per position, regenerating overwrites" shape as InterviewPrep,
/// but a separate model rather than a field on it — 群面 is a distinct
/// interview format most positions never actually use, not an extra section
/// of the same 1:1 prep content.
model GroupInterviewPrep {
  id         String   @id @default(cuid())
  userId     String
  positionId String   @unique
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Same "one per position, regenerating overwrites" shape as InterviewPrep —
/// a drafted 自荐信/求职信 for a candidate-pool position, built from its JD
/// and a chosen resume version (src/lib/resume-context.ts).
model CoverLetter {
  id         String   @id @default(cuid())
  userId     String
  positionId String   @unique
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Post-application mock interview: a generated question bank + reference
// answers for the specific position actually applied to. One per
// application; regenerating overwrites.
model InterviewQA {
  id            String   @id @default(cuid())
  userId        String
  applicationId String   @unique
  content       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User-authored reminders/plans — the auto-derived 待办 in todos.ts covers
// deadlines the app already knows about (position deadline, stale
// application, next-step date), but nothing lets the user write their own
// plan ("周五前联系内推人", "复习 XX 准备二面"). This does. Optionally links
// to a position or application so it can surface on that record's timeline,
// but standalone tasks (positionId/applicationId both null) are equally
// valid — not everything is tied to a specific job.
model PersonalTask {
  id            String    @id @default(cuid())
  userId        String
  title         String
  note          String?
  dueDate       DateTime?
  /// End of a window, same idea as StageHistory.nextDeadlineEnd — a
  /// self-authored task can equally be "笔试窗口 8/26-8/30" rather than a
  /// single due moment.
  dueDateEnd    DateTime?
  done          Boolean   @default(false)
  positionId    String?
  applicationId String?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// A recruiter, referrer, or interviewer worth keeping track of — who they
/// are, how to reach them, and when to follow up. Distinct from
/// Application.referrer (a free-text name on one investment record): a
/// contact is a person, not an attribute of one application, and the same
/// person often spans multiple roles/rounds at the same company or shows up
/// again at a different one next season.
model Contact {
  id              String    @id @default(cuid())
  userId          String
  name            String
  /// Free text rather than an enum — "HR"/"内推人"/"技术面试官"/"猎头" and
  /// combinations of those don't fit a fixed list.
  role            String?
  companyName     String?
  /// Free text: 微信号/邮箱/电话, whatever the user actually has for them —
  /// no reason to force three separate fields when most contacts only have
  /// one channel worth recording.
  contactInfo     String?
  note            String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  positionId      String?
  applicationId   String?
  createdAt       DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum InterviewMessageRole {
  USER
  ASSISTANT
}

enum InterviewSessionStatus {
  ACTIVE
  ENDED
}

// A real back-and-forth mock interview — distinct from InterviewQA (a
// one-shot question bank). This is multi-turn, so it costs several AI calls
// per session instead of one; gated behind the user having their own API
// key configured (see src/lib/actions/interview-session.ts) so one long
// session can't burn through the shared free-tier quota for everyone else.
model InterviewSession {
  id              String                 @id @default(cuid())
  userId          String
  resumeVersionId String
  positionId      String?
  // Free-text fallback ("后端开发") when no specific candidate position was
  // picked — the interview still needs *some* target to ask about.
  targetRole      String?
  // When set, the interviewer AI is told to mix in LeetCode-style coding
  // questions and to review any pasted code like a code reviewer would
  // (correctness, edge cases, complexity) — not a real judge with test-case
  // execution, see src/lib/actions/interview-session.ts.
  includeCoding   Boolean                @default(false)
  // Copied in at session-start time from an InterviewIntelligence
  // recommendation ("40% C++ / 25% 算法比较 / ..."), if the user chose to
  // start from one — a plain string the interviewer prompt weaves in each
  // turn, not a structured field the app itself reasons about further.
  focusMix        String?
  status          InterviewSessionStatus @default(ACTIVE)
  feedback        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion      @relation(fields: [resumeVersionId], references: [id])
  position      Position?          @relation(fields: [positionId], references: [id])
  messages      InterviewMessage[]

  @@index([userId])
}

model InterviewMessage {
  id           String               @id @default(cuid())
  sessionId    String
  role         InterviewMessageRole
  content      String
  /// Only set on spoken answers: what the audio reveals that a transcript
  /// can't — pace, filler words, hesitation. Kept out of `content` so the
  /// transcript stays a clean record of *what* was said while the
  /// end-of-session feedback can still judge *how* it was said.
  deliveryNote String?
  createdAt    DateTime             @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// A set of interview questions that can live on its own, separate from
/// InterviewQA (which is generated for one specific application and is
/// deleted with it). Banks are what people actually trade with each other in
/// 秋招 group chats, so they need to be importable and exportable — which
/// means they cannot be tied to one of *this* user's applications.
model QuestionBank {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Where it came from: a company name, a friend's share, "AI 生成", …
  source    String?
  /// QuestionBankItem[] — see src/lib/question-bank-shared.ts. Stored as JSON
  /// rather than a table because a bank is always read and written whole;
  /// nothing ever queries across individual questions.
  questions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ExamSessionStatus {
  ACTIVE
  ENDED
}

/// A timed practice run through a subset of a QuestionBank. Deliberately
/// snapshots the questions (and later, answers/grading) as JSON rather than
/// referencing QuestionBank.questions live — a bank gets edited over time
/// (AI re-classifies modules, answers get filled in), and a past exam's
/// content must not silently change out from under its own score history.
model ExamSession {
  id              String            @id @default(cuid())
  userId          String
  /// The source bank, kept only so "重考一次" can re-pull from the same
  /// pool — never dereferenced to render the exam itself.
  bankId          String?
  bankName        String
  /// Modules selected when starting, or null if the whole bank was used.
  modules         Json?
  /// QuestionBankItem[] snapshot at exam start (question/module/category/
  /// referenceAnswer/tips) — see src/lib/question-bank-shared.ts.
  questions       Json
  /// Parallel array to `questions`, filled in on submit:
  /// {answer, score, feedback}[]. Null until the exam is submitted.
  answers         Json?
  status          ExamSessionStatus @default(ACTIVE)
  overallScore    Int?
  summary         String?
  /// Minutes the user was given — advisory (client auto-submits at zero),
  /// not enforced server-side.
  durationMinutes Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PersonalityTestType {
  OCEAN
  MBTI
  DISC
  HOLLAND
}

// Self-authored, simplified self-assessments (see src/lib/personality-tests/)
// — not reproductions of any proprietary or academic instrument. Scored
// entirely client-side by fixed rules, no AI call involved; this table just
// persists the result so a user can revisit it without retaking.
model PersonalityTestResult {
  id          String              @id @default(cuid())
  userId      String
  testType    PersonalityTestType
  answers     Json
  scores      Json
  resultLabel String
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// AI synthesis across whichever personality tests the user has completed —
// one per user, overwritten on regenerate (like InterviewPrep/InterviewQA).
// A one-shot generation on the shared quota, not gated behind BYOK.
model CareerFitAnalysis {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
