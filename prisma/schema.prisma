generator client {
  provider = "prisma-client-js"
  // Prisma only bundles the query engine binary for whatever platform
  // `prisma generate` actually ran on — this repo has only ever been built
  // on this Mac, so every packaged Windows release so far shipped with
  // zero working database engine (query_engine binary present for
  // darwin-arm64 only), meaning literally every DB-backed page crashed on
  // launch and fell straight to the generic Next.js error boundary.
  // "native" keeps local dev working on whatever machine runs `generate`;
  // "windows" adds the x64 engine electron-builder's Windows targets need
  // (works under emulation for the arm64 NSIS build too — Prisma has no
  // separate windows-arm64 engine to target).
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js) ----------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  name           String?
  phone          String?
  school         String?
  targetTrack    String?
  graduationYear Int?
  skills         String?
  preferredCities String?
  expectedSalaryMin Int?
  emailVerified  DateTime?
  image          String?
  // Bring-your-own AI key(s) — see AiKey below, one row per provider, AES
  // -encrypted at rest (src/lib/crypto.ts). defaultAiProvider picks which
  // configured key the general text-only AI features use; file-reading
  // features (JD parsing, resume check, resume match) ignore this and
  // always look up the "gemini" key specifically, since only Gemini's API
  // here can read a PDF/image directly.
  defaultAiProvider   String?
  // Local build only: sends reminder digests via the user's own mailbox
  // (SMTP) since there's no always-on server here to run a hosted email
  // service against. Password is AES-encrypted the same way as the AI key.
  smtpHost               String?
  smtpPort               Int?
  smtpUser               String?
  smtpPasswordEncrypted  String?
  smtpFrom               String?
  createdAt      DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  positions      Position[]
  applications   Application[]
  resumeVersions ResumeVersion[]
  addedCompanies Company[]
  attachments    Attachment[]
  interviewPreps InterviewPrep[]
  interviewQAs   InterviewQA[]
  personalTasks  PersonalTask[]
  interviewSessions InterviewSession[]
  personalityTestResults PersonalityTestResult[]
  careerFitAnalysis      CareerFitAnalysis?
  aiKeys                 AiKey[]
  jobLeads               JobLead[]
  questionBanks          QuestionBank[]
  examSessions           ExamSession[]
  mailAccounts           MailAccount[]
  contacts               Contact[]
}

/// One inbox to scan for job-related mail — a user routinely needs several:
/// recruiters require whatever mailbox provider they standardize on (e.g.
/// Tencent → QQ mailbox, NetEase → 163 mailbox), so a single-mailbox scan
/// config misses everything sent to the others. Deliberately independent of
/// User's smtp* fields, which are the *sending* identity for reminder
/// digests — that's a separate concern from which inboxes get read.
model MailAccount {
  id              String    @id @default(cuid())
  userId          String
  /// User-given name so multiple accounts are distinguishable at a glance
  /// ("QQ邮箱" / "网易邮箱") — falls back to the email address if blank.
  label           String?
  imapHost        String
  imapPort        Int
  email           String
  passwordEncrypted String
  enabled         Boolean   @default(true)
  /// Per-account, not global — accounts added at different times must not
  /// all inherit one shared "since" cursor, or a newly-added account would
  /// either re-scan years of mail (cursor null) or skip its own backlog
  /// (cursor copied from an older account).
  lastCheckedAt   DateTime?
  /// IMAP UID high-water mark — the actual de-dup cursor. lastCheckedAt
  /// alone isn't enough: IMAP's SEARCH SINCE only has day granularity (no
  /// time-of-day), so two scans on the same calendar day both re-match
  /// every message since midnight and re-create a 待办 for mail already
  /// processed earlier that day. UIDs are stable and strictly increasing
  /// within one mailbox, so "uid > lastSeenUid" never re-matches a message
  /// already seen, regardless of how many times per day this runs.
  lastSeenUid     Int?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiKey {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  apiKeyEncrypted String
  model           String?
  // Only meaningful for OpenAI-compatible providers (openai/deepseek/kimi/qwen)
  // — overrides that provider's default base URL, for workspace-specific or
  // self-hosted OpenAI-compatible endpoints (e.g. Alibaba Cloud 百炼's
  // per-workspace MaaS gateway, which isn't the same for every account).
  baseUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain ----------

model Company {
  id            String   @id @default(cuid())
  name          String   @unique
  industry      String?
  size          String?
  logoUrl       String?
  careerUrl     String?
  sector        String?
  verified      Boolean  @default(false)
  addedByUserId String?
  createdAt     DateTime @default(now())

  addedBy      User?         @relation(fields: [addedByUserId], references: [id])
  positions    Position[]
  applications Application[]
}

enum PositionStatus {
  EVALUATING
  PLANNED
  APPLIED
  DROPPED
}

/// A raw row from an imported 秋招信息表 — the wide, messy, mostly-irrelevant
/// list that circulates in group chats. Deliberately NOT a Position: the
/// candidate pool is the small curated set the user actually intends to apply
/// to, and dumping hundreds of leads into it would bury that. Leads live here
/// until the user promotes one, at which point promotedPositionId is set so
/// the library can show it's already been taken.
model JobLead {
  id          String    @id @default(cuid())
  userId      String
  companyName String
  title       String
  track       String?
  department  String?
  location    String?
  salaryMin   Int?
  salaryMax   Int?
  deadline    DateTime?
  source      String?
  jdUrl       String?
  note        String?
  /// 0-100 from the AI resume match; null until the user runs a match.
  fitScore    Int?
  fitReason   String?
  /// Filename of the sheet this came from, so a bad import can be found again.
  batch       String?
  promotedPositionId String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Position {
  id             String         @id @default(cuid())
  userId         String
  companyId      String
  title          String
  track          String?
  department     String?
  location       String?
  salaryMin      Int?
  salaryMax      Int?
  jdText         String?
  jdUrl          String?
  source         String?
  scoreBreakdown Json?
  interestScore  Int?
  deadline       DateTime?
  status         PositionStatus @default(EVALUATING)
  createdAt      DateTime       @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]
  interviewPrep InterviewPrep?
  personalTasks PersonalTask[]
  interviewSessions InterviewSession[]
  contacts      Contact[]

  @@index([userId])
}

enum ApplicationStage {
  APPLIED
  SCREENING
  ASSESSMENT
  OA
  INTERVIEW_1
  INTERVIEW_2
  INTERVIEW_3
  HR_INTERVIEW
  OFFER
  REJECTED
  ACCEPTED
  DECLINED
}

model Application {
  id               String           @id @default(cuid())
  userId           String
  positionId       String?
  companyId        String
  resumeVersionId  String?
  title            String
  appliedDate      DateTime
  referrer         String?
  source           String?
  currentStage     ApplicationStage @default(APPLIED)
  currentStageDate DateTime         @default(now())
  salaryMin        Int?
  salaryMax        Int?
  offerNote        String?
  /// Offer comparison beyond the headline monthly salary. A 30K/month offer
  /// with a 90-minute commute and routine 996 is not the same offer as a 28K
  /// one twenty minutes away, and comparing on salaryMin/Max alone hides
  /// exactly that.
  /// Total annual package in 万元 (base + bonus + stock), as offers here are
  /// quoted that way; monthly salary stays in salaryMin/Max as K.
  offerAnnualTotal Int?
  /// One-way commute in minutes.
  commuteMinutes   Int?
  /// Free text rather than an enum — "大小周", "弹性但晚上要盯线上" and
  /// "旺季前一个月封闭" are all real answers that no fixed list covers.
  overtimeNote     String?
  /// Growth prospects: team, mentor, tech stack, promotion path.
  growthNote       String?
  createdAt        DateTime         @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  position      Position?       @relation(fields: [positionId], references: [id])
  company       Company         @relation(fields: [companyId], references: [id])
  resumeVersion ResumeVersion?  @relation(fields: [resumeVersionId], references: [id])
  stageHistory  StageHistory[]
  attachments   Attachment[]
  interviewQA   InterviewQA?
  personalTasks PersonalTask[]
  contacts      Contact[]

  @@index([userId])
}

model StageHistory {
  id              String           @id @default(cuid())
  applicationId   String
  stage           ApplicationStage
  enteredAt       DateTime         @default(now())
  note            String?
  interviewFormat String?
  interviewer     String?
  nextDeadline    DateTime?
  /// End of a window when the next step isn't a single fixed moment — 笔试/
  /// 测评 links routinely say "8月26日-8月30日期间任意时间可测" rather than
  /// giving one deadline. Null means nextDeadline is a single point in time
  /// (an interview slot, a fixed deadline); set means [nextDeadline,
  /// nextDeadlineEnd] is the window.
  nextDeadlineEnd DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([applicationId])
}

model Attachment {
  id             String   @id @default(cuid())
  userId         String
  applicationId  String?
  stageHistoryId String?
  url            String
  name           String
  /// Shelf in the 资料库 (证书 / 作品集 / 笔试资料 / 其他). Null on the
  /// attachments that predate the library, and on ones uploaded straight
  /// onto an application, where the application itself is the context.
  category       String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageHistory StageHistory? @relation(fields: [stageHistoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([stageHistoryId])
}

model ResumeVersion {
  id          String   @id @default(cuid())
  userId      String
  name        String
  fileUrl     String?
  targetTrack String?
  isDefault   Boolean  @default(false)
  // Cached AI review — each run is a paid call, so results persist instead of
  // re-running every time the page is opened.
  checkScore  Int?
  checkResult Json?
  checkedAt   DateTime?
  createdAt   DateTime @default(now())

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     Application[]
  interviewSessions InterviewSession[]

  @@index([userId])
}

// Pre-application prep guide: what to prepare before applying. Lives on
// Position because that's the "haven't applied yet" stage — Application only
// exists once 标记已投. One per position; regenerating overwrites.
model InterviewPrep {
  id         String   @id @default(cuid())
  userId     String
  positionId String   @unique
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Post-application mock interview: a generated question bank + reference
// answers for the specific position actually applied to. One per
// application; regenerating overwrites.
model InterviewQA {
  id            String   @id @default(cuid())
  userId        String
  applicationId String   @unique
  content       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User-authored reminders/plans — the auto-derived 待办 in todos.ts covers
// deadlines the app already knows about (position deadline, stale
// application, next-step date), but nothing lets the user write their own
// plan ("周五前联系内推人", "复习 XX 准备二面"). This does. Optionally links
// to a position or application so it can surface on that record's timeline,
// but standalone tasks (positionId/applicationId both null) are equally
// valid — not everything is tied to a specific job.
model PersonalTask {
  id            String    @id @default(cuid())
  userId        String
  title         String
  note          String?
  dueDate       DateTime?
  /// End of a window, same idea as StageHistory.nextDeadlineEnd — a
  /// self-authored task can equally be "笔试窗口 8/26-8/30" rather than a
  /// single due moment.
  dueDateEnd    DateTime?
  done          Boolean   @default(false)
  positionId    String?
  applicationId String?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// A recruiter, referrer, or interviewer worth keeping track of — who they
/// are, how to reach them, and when to follow up. Distinct from
/// Application.referrer (a free-text name on one investment record): a
/// contact is a person, not an attribute of one application, and the same
/// person often spans multiple roles/rounds at the same company or shows up
/// again at a different one next season.
model Contact {
  id              String    @id @default(cuid())
  userId          String
  name            String
  /// Free text rather than an enum — "HR"/"内推人"/"技术面试官"/"猎头" and
  /// combinations of those don't fit a fixed list.
  role            String?
  companyName     String?
  /// Free text: 微信号/邮箱/电话, whatever the user actually has for them —
  /// no reason to force three separate fields when most contacts only have
  /// one channel worth recording.
  contactInfo     String?
  note            String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  positionId      String?
  applicationId   String?
  createdAt       DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum InterviewMessageRole {
  USER
  ASSISTANT
}

enum InterviewSessionStatus {
  ACTIVE
  ENDED
}

// A real back-and-forth mock interview — distinct from InterviewQA (a
// one-shot question bank). This is multi-turn, so it costs several AI calls
// per session instead of one; gated behind the user having their own API
// key configured (see src/lib/actions/interview-session.ts) so one long
// session can't burn through the shared free-tier quota for everyone else.
model InterviewSession {
  id              String                  @id @default(cuid())
  userId          String
  resumeVersionId String
  positionId      String?
  // Free-text fallback ("后端开发") when no specific candidate position was
  // picked — the interview still needs *some* target to ask about.
  targetRole      String?
  status          InterviewSessionStatus  @default(ACTIVE)
  feedback        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion      @relation(fields: [resumeVersionId], references: [id])
  position      Position?          @relation(fields: [positionId], references: [id])
  messages      InterviewMessage[]

  @@index([userId])
}

model InterviewMessage {
  id        String               @id @default(cuid())
  sessionId String
  role      InterviewMessageRole
  content   String
  /// Only set on spoken answers: what the audio reveals that a transcript
  /// can't — pace, filler words, hesitation. Kept out of `content` so the
  /// transcript stays a clean record of *what* was said while the
  /// end-of-session feedback can still judge *how* it was said.
  deliveryNote String?
  createdAt DateTime             @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// A set of interview questions that can live on its own, separate from
/// InterviewQA (which is generated for one specific application and is
/// deleted with it). Banks are what people actually trade with each other in
/// 秋招 group chats, so they need to be importable and exportable — which
/// means they cannot be tied to one of *this* user's applications.
model QuestionBank {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Where it came from: a company name, a friend's share, "AI 生成", …
  source    String?
  /// QuestionBankItem[] — see src/lib/question-bank-shared.ts. Stored as JSON
  /// rather than a table because a bank is always read and written whole;
  /// nothing ever queries across individual questions.
  questions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ExamSessionStatus {
  ACTIVE
  ENDED
}

/// A timed practice run through a subset of a QuestionBank. Deliberately
/// snapshots the questions (and later, answers/grading) as JSON rather than
/// referencing QuestionBank.questions live — a bank gets edited over time
/// (AI re-classifies modules, answers get filled in), and a past exam's
/// content must not silently change out from under its own score history.
model ExamSession {
  id        String            @id @default(cuid())
  userId    String
  /// The source bank, kept only so "重考一次" can re-pull from the same
  /// pool — never dereferenced to render the exam itself.
  bankId    String?
  bankName  String
  /// Modules selected when starting, or null if the whole bank was used.
  modules   Json?
  /// QuestionBankItem[] snapshot at exam start (question/module/category/
  /// referenceAnswer/tips) — see src/lib/question-bank-shared.ts.
  questions Json
  /// Parallel array to `questions`, filled in on submit:
  /// {answer, score, feedback}[]. Null until the exam is submitted.
  answers      Json?
  status       ExamSessionStatus @default(ACTIVE)
  overallScore Int?
  summary      String?
  /// Minutes the user was given — advisory (client auto-submits at zero),
  /// not enforced server-side.
  durationMinutes Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PersonalityTestType {
  OCEAN
  MBTI
  DISC
  HOLLAND
}

// Self-authored, simplified self-assessments (see src/lib/personality-tests/)
// — not reproductions of any proprietary or academic instrument. Scored
// entirely client-side by fixed rules, no AI call involved; this table just
// persists the result so a user can revisit it without retaking.
model PersonalityTestResult {
  id          String              @id @default(cuid())
  userId      String
  testType    PersonalityTestType
  answers     Json
  scores      Json
  resultLabel String
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// AI synthesis across whichever personality tests the user has completed —
// one per user, overwritten on regenerate (like InterviewPrep/InterviewQA).
// A one-shot generation on the shared quota, not gated behind BYOK.
model CareerFitAnalysis {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

