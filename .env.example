# PostgreSQL connection string
DATABASE_URL="postgresql://USER@localhost:5432/careerplatform"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: leave blank to hide the Google login button
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (resume / interview attachment uploads)
BLOB_READ_WRITE_TOKEN=""

# Resend (password reset + daily reminder emails)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Protects /api/cron/reminders from being called by anyone else
# Generate with: openssl rand -hex 24
CRON_SECRET=""
