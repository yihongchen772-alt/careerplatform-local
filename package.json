{
  "name": "careerplatform",
  "version": "0.1.0",
  "private": true,
  "description": "秋招追踪 本地单机版",
  "author": "yihong",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "electron:dev": "electron electron/main.js",
    "electron:build": "next build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.careerplatform.local",
    "productName": "秋招追踪",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          ".next/**/*",
          "public/**/*",
          "prisma/**/*",
          "node_modules/**/*",
          "package.json",
          "next.config.ts",
          "!node_modules/electron/**",
          "!node_modules/electron-builder/**",
          "!node_modules/playwright/**",
          "!node_modules/playwright-core/**",
          "!node_modules/typescript/**",
          "!node_modules/eslint*/**",
          "!node_modules/@typescript-eslint/**",
          "!node_modules/tailwindcss/**",
          "!node_modules/@tailwindcss/**",
          "!node_modules/wait-on/**",
          "!node_modules/@types/**",
          "!node_modules/.cache/**"
        ]
      },
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      },
      {
        "from": "node_modules/.bin",
        "to": "app/node_modules/.bin"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
