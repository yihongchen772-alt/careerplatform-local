{
  "name": "careerplatform",
  "version": "0.8.2",
  "private": true,
  "description": "求职罗盘 本地单机版",
  "author": "yihong",
  "main": "electron/main.js",
  "scripts": {
    "local:setup": "node scripts/setup-local.cjs",
    "local:dev": "next dev --hostname 127.0.0.1",
    "local:start": "node scripts/local-server.cjs",
    "test:agent": "node --test tests/agent.test.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "electron:dev": "electron electron/main.js",
    "electron:build": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --publish never",
    "desktop:prepare": "node scripts/packaging-build.cjs && node scripts/packaging-prepare.cjs",
    "electron:build:win": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --win --x64 --publish never",
    "electron:build:mac": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --mac --arm64 --publish never",
    "test:desktop": "node --test tests/updater.test.cjs tests/desktop-data.test.cjs",
    "local:data": "node scripts/desktop-data.cjs inspect"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "imapflow": "^1.7.2",
    "lucide-react": "^1.33.0",
    "mailparser": "^3.9.15",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
